{
  "expo": {
    "name": "Dubora",
    "slug": "dubora",
    "version": "0.1.0",
    "orientation": "default",
    "scheme": "dubora",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nolabjfjdj.dubora"
    },
    "android": {
      "package": "com.nolabjfjdj.dubora"
    }
  }
}